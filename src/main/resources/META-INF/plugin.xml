<idea-plugin>
  <id>dev.nowtech.aichat.claudecli.native</id>
  <name>Ai Chat Claude CLI Native</name>
  <vendor url="https://jetbrains.nowtech.dev">NOW Tech</vendor>
  <description><![CDATA[
    Installs the <b>Claude CLI</b> agent for JetBrains <b>AI Chat</b> (ACP), so you can use
    <b>Claude Code Teams</b> with the same <code>claude</code> login as in the terminal — not the
    JetBrains-hosted Claude API key flow.<br/><br/>
    On startup (optional), the plugin merges <code>~/.jetbrains/acp.json</code>, deploys
    <code>claude-teams-acp</code> in WSL/Linux, and installs
    <code>@agentclientprotocol/claude-agent-acp@0.99.0</code> without <code>npx</code>.<br/><br/>
    <a href="https://jetbrains.nowtech.dev"><font color="#589DF6">jetbrains.nowtech.dev</font></a>
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.ml.llm</depends>

  <extensions defaultExtensionNs="com.intellij">
    <postStartupActivity implementation="dev.nowtech.aichat.claudecli.native.AcpInstallStartupActivity"/>
    <applicationConfigurable
        parentId="tools"
        instance="dev.nowtech.aichat.claudecli.native.settings.NativeAcpConfigurable"
        id="dev.nowtech.aichat.claudecli.native.settings"
        displayName="Ai Chat Claude CLI Native"/>
    <applicationService
        serviceImplementation="dev.nowtech.aichat.claudecli.native.settings.NativeAcpSettings"/>
    <notificationGroup id="Ai Chat Claude CLI Native" displayType="BALLOON"/>
  </extensions>

  <actions>
    <action
        id="dev.nowtech.aichat.claudecli.native.Install"
        class="dev.nowtech.aichat.claudecli.native.InstallNativeAcpAction"
        text="Install Claude CLI for AI Chat…"
        description="Install or repair the Claude CLI ACP agent"/>
    <group id="dev.nowtech.aichat.claudecli.native.ToolsGroup">
      <reference ref="dev.nowtech.aichat.claudecli.native.Install"/>
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </group>
  </actions>
</idea-plugin>
